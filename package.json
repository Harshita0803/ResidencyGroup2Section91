{
  "name": "health-check-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, no-AI chatbot that recommends a specialist from symptoms and books a demo appointment.",
  "scripts": {
    "predev": "node scripts/generate-data.mjs --if-missing",
    "dev": "next dev",
    "build": "node scripts/generate-data.mjs --if-missing && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:data": "node scripts/generate-data.mjs"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
